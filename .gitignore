# Core-source allowlist: generated data and operational artifacts stay on server.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY.md
!/requirements.txt
!/package.json
!/package-lock.json
!/adapter.py
!/bootstrap.py
!/build_gallery.py
!/compact.py
!/native.py
!/pipeline.py
!/plot_layout.py
!/presentation.py
!/text_layout.py
!/verify_native.py
!/render.mjs
!/configs/
/configs/*
!/configs/smoke.json
!/configs/production.json
!/configs/examples.json
!/tests/
/tests/*
!/tests/test_*.py
!/docs/
/docs/*
!/docs/*.md
!/vendor/
/vendor/*
!/vendor/VSR/
/vendor/VSR/*
!/vendor/VSR/LICENSE
!/vendor/VSR/chart_generation/
!/vendor/VSR/data_pipeline/
/vendor/VSR/chart_generation/*
!/vendor/VSR/chart_generation/*.py
!/vendor/VSR/chart_generation/words.txt
/vendor/VSR/data_pipeline/*
!/vendor/VSR/data_pipeline/*.py

# Never track credentials, installed packages, downloaded fonts or build caches.
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_ed25519*
**/id_rsa*
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.cache/
**/assets/
