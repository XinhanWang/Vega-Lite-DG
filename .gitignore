# Core-source allowlist: generated data and operational artifacts stay on server.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY.md
!/requirements.txt
!/package.json
!/package-lock.json
!/adapter.py
!/bootstrap.py
!/build_gallery.py
!/compact.py
!/native.py
!/pipeline.py
!/plot_layout.py
!/presentation.py
!/text_layout.py
!/render.mjs
!/ordering.py
!/generation/
/generation/*
!/generation/*.py
!/generation/words.txt
!/workflow/
/workflow/*
!/workflow/*.py
!/configs/
/configs/*
!/configs/smoke.json
!/configs/production.json
!/configs/examples.json
!/tests/
/tests/*
!/tests/*.py
!/docs/
/docs/*
!/docs/*.md
!/vendor/
/vendor/*
!/vendor/VSR/
/vendor/VSR/*
!/vendor/VSR/LICENSE
# Never track credentials, installed packages, downloaded fonts or build caches.
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_ed25519*
**/id_rsa*
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.cache/
**/assets/

# SVG font embedding and reproducible style-reference fixtures.
!/font_embedding.py
!/fonts.manifest.json
!/docs/font-licenses/
/docs/font-licenses/*
!/docs/font-licenses/README.md
!/docs/font-licenses/*.txt
!/docs/font-licenses/urw-base35-3c0ba3b-source.tar.gz
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/style-canvas-vsr-8b2ca38.json
!/tests/fixtures/native-1.0-barv-1.json

# Static VSR parameter implementations; no renderer code or generated datasets.
!/generation/vsr_samplers/
/generation/vsr_samplers/*
!/generation/vsr_samplers/*.py

# Frozen original-VSR parameter/text references used by offline regression tests.
!/tests/fixtures/vsr_samplers/
/tests/fixtures/vsr_samplers/*
!/tests/fixtures/vsr_samplers/*.gz
!/tests/fixtures/vsr_samplers/*.json
!/tests/fixtures/vsr_samplers/*.py
!/tests/fixtures/vsr_samplers/README.md
!/tests/vsr_text_fixtures/
/tests/vsr_text_fixtures/*
!/tests/vsr_text_fixtures/*.txt
!/tests/vsr_text_fixtures/*.json

# Display-only compilation of semantic training targets.
!/compact_display.py
